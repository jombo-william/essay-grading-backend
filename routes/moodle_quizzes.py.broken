# Add this endpoint to manually sync a quiz to Moodle

@router.post("/sync-quiz/{quiz_id}")
def sync_quiz_to_moodle(
    quiz_id: int,
    moodle_course_id: int = Query(...),
    moodle_token: str = Query(...),
    site_url: str = Query(...),
    db: Session = Depends(get_db),
    ctx: dict = Depends(require_teacher)
):
    """Manually sync an existing quiz to Moodle"""
    user = ctx["user"]
    
    # Get the quiz
    quiz = db.query(models.Quiz).filter(
        models.Quiz.id == quiz_id,
        models.Quiz.teacher_id == user.id
    ).first()
    
    if not quiz:
        raise HTTPException(status_code=404, detail="Quiz not found")
    
    if quiz.moodle_quiz_id:
        return {
            "success": False,
            "message": f"Quiz already synced to Moodle (ID: {quiz.moodle_quiz_id})"
        }
    
    try:
        # Create quiz in Moodle
        create_params = {
            "courseid": moodle_course_id,
            "name": quiz.title,
            "intro": quiz.description or "",
            "introformat": 1,
            "timelimit": (quiz.time_limit_minutes or 0) * 60,
        }
        
        result = moodle_call(
            token=moodle_token,
            function="mod_quiz_add_quiz",
            params=create_params
        )
        
        moodle_quiz_id = result.get("id")
        
        if moodle_quiz_id:
            # Add questions
            questions = quiz.questions if isinstance(quiz.questions, list) else json.loads(quiz.questions)
            for idx, q in enumerate(questions):
                question_params = {
                    "quizid": moodle_quiz_id,
                    "name": f"Q{idx+1}: {q.get('question_text', '')[:50]}",
                    "questiontext": q.get('question_text', ''),
                    "questiontextformat": 1,
                    "defaultmark": q.get('points', 1),
                }
                
                if q.get('question_type') == "multiple_choice":
                    question_params["type"] = "multichoice"
                    question_params["single"] = 1
                    for opt_idx, opt in enumerate(q.get('options', [])):
                        question_params[f"answer_{opt_idx+1}"] = opt.get('text', '')
                        question_params[f"fraction_{opt_idx+1}"] = 1.0 if opt.get('is_correct') else 0.0
                elif q.get('question_type') == "true_false":
                    question_params["type"] = "truefalse"
                    question_params["answer_1"] = "True"
                    question_params["answer_2"] = "False"
                    question_params["fraction_1"] = 1.0 if q.get('correct_answer') == "True" else 0.0
                elif q.get('question_type') == "short_answer":
                    question_params["type"] = "shortanswer"
                    if q.get('correct_answer'):
                        question_params["answer_1"] = q.get('correct_answer')
                        question_params["fraction_1"] = 1.0
                elif q.get('question_type') == "essay":
                    question_params["type"] = "essay"
                
                moodle_call(
                    token=moodle_token,
                    function="mod_quiz_add_question",
                    params=question_params
                )
            
            # Update the quiz with Moodle ID
            quiz.moodle_quiz_id = moodle_quiz_id
            quiz.moodle_course_id = moodle_course_id
            db.commit()
            
            return {
                "success": True,
                "message": f"Quiz synced to Moodle! Moodle ID: {moodle_quiz_id}",
                "moodle_quiz_id": moodle_quiz_id
            }
        else:
            return {
                "success": False,
                "message": f"Failed to create quiz in Moodle: {result}"
            }
            
    except Exception as e:
        return {
            "success": False,
            "message": f"Sync failed: {str(e)}"
        }
